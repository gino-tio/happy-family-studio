# Cloudflare Pages headers. The toolution.net zone's Browser Cache TTL raised
# the app's JS to 4 hours, so a deploy took up to 4 hours to reach phones.
# no-cache = the browser may keep a copy but checks for a new one every time.
/*.js
  Cache-Control: no-cache
/*.wasm
  Cache-Control: no-cache
/*.json
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
